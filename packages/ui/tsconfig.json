{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "typeRoots": ["../../apps/frontend/node_modules/@types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "react": ["../../apps/frontend/node_modules/react"],
      "react/*": ["../../apps/frontend/node_modules/react/*"],
      "react/jsx-runtime": ["../../apps/frontend/node_modules/react/jsx-runtime"],
      "lucide-react": ["../../apps/frontend/node_modules/lucide-react"],
      "clsx": ["../../apps/frontend/node_modules/clsx"],
      "tailwind-merge": ["../../apps/frontend/node_modules/tailwind-merge"],
      "framer-motion": ["../../apps/frontend/node_modules/framer-motion"]
    }
  },
  "include": ["src"]
}
