{
  "name": "wazn-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter wazn-frontend",
    "dev:backend": "turbo run dev --filter wazn-backend",
    "build:frontend": "turbo run build --filter wazn-frontend",
    "build:backend": "turbo run build --filter wazn-backend",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "pnpm@9.1.0"
}
