{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/database/migrate.ts",
    "src/database/reset.ts",
    "src/database/test-seed.ts",
    "src/database/query-results.ts",
    "src/database/reset-categories.ts",
    "src/features/transactions/test-phase2.ts",
    "src/features/transactions/verify-phase2.ts"
  ]
}
