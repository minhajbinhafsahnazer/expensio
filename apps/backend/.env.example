# Wazn Backend â€” Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env â€” only .env.example should be in version control.
#
# Production: All variables marked REQUIRED must be set.
#             The server will refuse to start if they are missing.
# Development: Safe defaults are applied when NODE_ENV != production.

# â”€â”€â”€ Application â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

NODE_ENV=development          # development | production | test

# Port the API listens on.
# Render, and Railway inject PORT automatically.
# Local development defaults to 4000 if not set.
PORT=4000

# â”€â”€â”€ Database (REQUIRED in production) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Local Docker development default (matches docker-compose.yml):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wazn

# Production example (Neon, Supabase, Railway, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# â”€â”€â”€ Authentication Secrets (REQUIRED in production) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=replace-with-a-64-char-random-hex-string
COOKIE_SECRET=replace-with-a-different-64-char-random-hex-string

# â”€â”€â”€ CORS (REQUIRED in production) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The exact URL of your frontend. No trailing slash.
# Production example: https://wazn.app
# Development default: http://localhost:5173

ALLOWED_ORIGIN=http://localhost:5173

# --- AI (optional — chatbot is disabled if key is absent) --------------------
# NEVER expose this key to the frontend or commit it to Git.
# Get your key from: https://platform.openai.com/api-keys

AI_API_KEY=

# Model to use. Defaults to gpt-4o-mini if not set.
# AI_MODEL=gpt-4o-mini

# LLM API base URL. Defaults to OpenAI. Override for any OpenAI-compatible API.
# AI_BASE_URL=https://api.openai.com/v1

# AI_PROVIDER controls which backend to use: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# For Gemini: get your key at https://aistudio.google.com/apikey
# AI_API_KEY=your-gemini-key-here

# Model to use. Gemini default: gemini-2.0-flash
# AI_MODEL=gemini-2.0-flash

# (OpenAI only) Base URL — leave unset for Gemini
# AI_BASE_URL=https://api.openai.com/v1

# Per-user daily message limit (default: 50)
# AI_DAILY_LIMIT=50
